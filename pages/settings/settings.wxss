.group-title { color: #888; margin: 42rpx 0 10rpx; font-size: 24rpx; }
.settings-group { border-radius: 16rpx; overflow: hidden; --td-cell-bg-color: #161617; --td-cell-title-color: #f5f1eb; --td-cell-note-color: #888; }
.setting { min-height: 92rpx; padding: 15rpx 4rpx; border-bottom: 1rpx solid #28282a; display: flex; align-items: center; justify-content: space-between; }
.tap:active { background: #171718; }
.hint { color: #888; font-size: 22rpx; margin-top: 6rpx; max-width: 570rpx; }
.name { text-align: right; color: #f47721; }
.map-note { padding: 20rpx 0 0; }
.favorite { display: inline-block; background: #242426; border-radius: 99rpx; padding: 10rpx 18rpx; margin: 10rpx 10rpx 0 0; font-size: 24rpx; }
.clear { width: 100%; margin-top: 20rpx; --td-button-default-bg-color: #242426; --td-button-default-color: #ddd; }
.empty { padding: 25rpx 0; }
.safe { margin-top: 48rpx; }
