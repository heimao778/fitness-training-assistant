<view class="page">
  <view class="title">{{name}}</view>
  <view class="subtitle">仅比较相同单位 kg 的真实完成记录</view>
  <view class="empty muted" wx:if="{{!rows.length}}">暂无记录</view>
  <view class="card" wx:for="{{rows}}" wx:key="sessionId" data-id="{{item.sessionId}}" bindtap="detail">
    <view class="row"><view class="card-title">{{item.date}}</view><view class="orange">纠错 ›</view></view>
    <view class="sets">
      <text wx:for="{{item.sets}}" wx:key="index">{{item.weight || '—'}} kg × {{item.reps || '—'}}<text wx:if="{{index < item.sets.length - 1}}">　</text></text>
    </view>
  </view>
</view>
